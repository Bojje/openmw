#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_nonuniform_qualifier : require

// Declared only so the stages agree on location 0. Nothing here writes to it: the shadow ray in
// raygen.rgen pre-initialises the payload to vec4(0.0), an accepted hit has to leave it that way, and
// shadow.rmiss is what sets w = 1 on a miss.
layout(location = 0) rayPayloadInEXT vec4 payload;

hitAttributeEXT vec2 attribs;

layout(buffer_reference, std430) readonly buffer Vertices { float v[]; };
layout(buffer_reference, std430) readonly buffer Indices  { uint  i[]; };

// Mirrors Vk::GeometryRecord in components/vk/vkgeometry.hpp, which static_asserts these offsets.
// The two addresses are buffer_reference types rather than uint64_t so this compiles without the
// shaderInt64 device feature, which the renderer does not enable.
struct GeometryRecord {
    Vertices vertices;
    Indices  indices;
    uint     textureIndex;
    uint     alphaTested;
    // The alpha test this shape was authored with, packed by Vk::packMaterialBits: bit 27 says there
    // is one, bits 24-26 the glAlphaFunc comparison, bits 16-23 the threshold in 0..255. Zero means
    // the shape authored none.
    uint     alphaBits;
    uint     pad1;
};

layout(set = 0, binding = 6, std430) readonly buffer Geometries { GeometryRecord records[]; } geometries;

// Slot 0 is the 1x1 white fallback, so scene texture i lives at i + 1. Unlike gbuffer.frag, where the
// index comes from a push constant, textureIndex here varies per hit within a subgroup and needs
// nonuniformEXT at every use.
layout(set = 0, binding = 7) uniform sampler2D textures[1024];

// Interleaved layout from vkgeometry.hpp: 12 floats per vertex, texcoord at floats 6 and 7.
const uint floatsPerVertex = 12;
const uint texCoordOffset = 6;

// Duplicated verbatim in closesthit.rchit. CompileShaders.cmake runs glslangValidator without an
// include path, so a shared .glsl is not an option; edit both copies together.
vec2 vertexTexCoord(Vertices vertices, uint index) {
    uint base = index * floatsPerVertex + texCoordOffset;
    return vec2(vertices.v[base], vertices.v[base + 1]);
}

vec2 interpolateTexCoord(Vertices vertices, Indices indices, vec3 weights) {
    uint triangle = uint(gl_PrimitiveID) * 3;
    return vertexTexCoord(vertices, indices.i[triangle + 0]) * weights.x
        + vertexTexCoord(vertices, indices.i[triangle + 1]) * weights.y
        + vertexTexCoord(vertices, indices.i[triangle + 2]) * weights.z;
}

void main() {
    GeometryRecord record = geometries.records[gl_InstanceCustomIndexEXT];

    // Opaque geometry is flagged as such in the BLAS and normally never reaches this shader, but
    // instance and ray flags can override that per trace. The check is far cheaper than the dependent
    // index/vertex reads and the texture fetch below.
    if (record.alphaTested == 0)
        return;

    vec3 weights = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);
    vec2 uv = interpolateTexCoord(record.vertices, record.indices, weights);
    float alpha = texture(textures[nonuniformEXT(record.textureIndex)], uv).a;

    // The same decision gbuffer.frag makes, branch for branch. The two have to stay equal: a leaf
    // texel the raster pass throws away must not go on casting a shadow, or the foliage's silhouette
    // and the shadow under it disagree -- which is what happened when only the raster pass learned to
    // read the authored threshold, and it showed as Bloodmoon's pines casting the shadow of a
    // slightly fatter tree.
    //
    // Unlike gbuffer.frag this tests the texture's alpha alone, with no vertex colour in it. There is
    // none to be had: the hit shaders recover only the UV from the vertex buffer, and interpolating a
    // vertex colour as well would cost another three reads per any-hit invocation on the hottest path
    // in the renderer. It differs only for shapes whose vertex alpha is not 1, which are rare.
    bool keep;
    if ((record.alphaBits & 0x08000000u) != 0u)
    {
        float threshold = float((record.alphaBits >> 16) & 0xFFu) / 255.0;
        uint func = (record.alphaBits >> 24) & 0x7u;
        if (func == 0u) keep = true;                   // ALWAYS
        else if (func == 1u) keep = alpha <  threshold; // LESS
        else if (func == 2u) keep = alpha == threshold; // EQUAL
        else if (func == 3u) keep = alpha <= threshold; // LEQUAL
        else if (func == 4u) keep = alpha >  threshold; // GREATER
        else if (func == 5u) keep = alpha != threshold; // NOTEQUAL
        else if (func == 6u) keep = alpha >= threshold; // GEQUAL
        else keep = false;                              // NEVER
    }
    else
    {
        keep = alpha >= 0.5;
    }

    if (!keep)
        ignoreIntersectionEXT;
}
