#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba16f) uniform image2D outputImage;
layout(set = 0, binding = 2) uniform sampler2D gbufferAlbedo;
layout(set = 0, binding = 3) uniform sampler2D gbufferNormal;
layout(set = 0, binding = 4) uniform sampler2D gbufferDepth;
layout(set = 0, binding = 8) uniform sampler2D gbufferMaterial;

// Temporal accumulator history. Read and write are separate images, and they have to be: pixel A
// reads the history at pixel B's reprojected location, which pixel B may already have overwritten.
// There is no ordering between raygen invocations, so a read-modify-write history is a data race.
//
// Storage images rather than samplers so the 2x2 gather can be done by hand: a tap that fails the
// depth or normal test must contribute exactly zero, and a hardware bilinear fetch would have
// blended it in before the shader could look at it.
layout(set = 0, binding =  9, rgba16f) uniform readonly  image2D historyIn;
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D historyOut;
layout(set = 0, binding = 11, rg32ui)  uniform readonly  uimage2D geomIn;
layout(set = 0, binding = 12, rg32ui)  uniform writeonly uimage2D geomOut;

// One-bounce indirect light: .rgb = bounce albedo, .a = sky visibility (the ambient occlusion term).
// Its own image because outputImage has no free channel: .r is sun visibility and .gba is reflected
// radiance.
layout(set = 0, binding = 13, rgba16f) uniform writeonly image2D indirectImage;

// Bounce albedo history, ping-ponged and reprojected exactly like the visibility history.
layout(set = 0, binding = 14, rgba16f) uniform readonly  image2D indirectIn;
layout(set = 0, binding = 15, rgba16f) uniform writeonly image2D indirectOut;

// The water surface's reflection, at half resolution -- one texel per 2x2 launch pixels. Read back by
// water.frag through a bilinear fetch in the composite pass.
//
// A target of its own rather than a channel of outputImage, and the reason is not that the channels
// are full (they are: .r is sun visibility, .gba is the specular reflection). It is that both of the
// existing targets are indexed by G-buffer pixel and describe the surface the G-buffer recorded --
// and at a water pixel that surface is the seabed, not the sea. The water plane is a second surface
// in front of it that the G-buffer knows nothing about, so it needs somewhere of its own to live.
// Sharing a channel would mean two surfaces claiming one texel with no way to say which.
//
// Half resolution because a reflection off a moving wave has no sharp detail of its own to lose, and
// it is the only new ray in the frame -- full resolution would cost four times as much for detail the
// waves destroy on the way through. 640x400xRGBA16F is 2 MB on a Steam Deck at 1280x800.
layout(set = 0, binding = 16, rgba16f) uniform writeonly image2D waterReflectOut;

// The scene sampler array, the same one the hit shaders reach at this binding. raygen needs it for
// exactly one texture -- the water normal map -- and the slot is dynamically uniform (it comes out of
// the UBO), so this needs no nonuniformEXT and no descriptor indexing feature. The binding's
// stageFlags on the C++ side had to gain RAYGEN for this; declaring a binding in a stage that is not
// in stageFlags is a validation error and undefined behaviour.
layout(set = 0, binding = 7) uniform sampler2D textures[512];

// Read from the scene UBO rather than push constants: two mat4 plus a vec4 is 144 bytes, over the
// 128-byte maxPushConstantsSize that Vulkan guarantees on all implementations.
//
// This must declare EVERY field of Vk::SceneData up to the last one used, in order. A prefix is legal
// GLSL and this shader got away with one for a long time, but the moment it needs a field past
// sunColor, any omitted field shifts every subsequent offset -- and the result is read as *something*,
// so there is no error, no validation message and no crash. Just a silently wrong matrix. Keep this
// in step with vkrenderer.hpp and composite.frag; nothing checks the three agree.
layout(set = 0, binding = 5) uniform SceneUBO {
    mat4 view;
    mat4 projection;
    mat4 viewInverse;
    mat4 projInverse;
    vec4 sunDirection;
    vec4 sunColor;
    vec4 ambientColor;
    vec4 skyColor;
    vec4 fogColor;
    vec4 fogParams;
    mat4 prevViewFromCurView;
    vec4 denoiseParams; // x = alphaMin, y = depth tolerance, z = normal dot, w = max history
    vec4 sunParams;     // x = cos of the sun's angular radius
    uint frameIndex;
    uint lightCount;
    uint isInterior;
    // Slot of textures/omw/water_nm.png in the sampler array. It cannot be a constant: the loader
    // compacts the array down to what the live cells reference, so the slot moves. This occupies what
    // was scenePad1, which keeps the block's size and every offset in it exactly where the
    // static_asserts in vkrenderer.hpp pin them -- adding a field instead would shift the layout in
    // six shader copies that nothing cross-checks.
    uint waterNormalMap;
} camera;

// Morrowind's world unit is roughly 1.4 cm and an exterior cell spans 8192 units, so ray epsilons have
// to be expressed at that scale. A sub-unit bias causes shadow rays to re-intersect their own surface,
// which shows up as dense diagonal acne across every lit face.
const float rayBias = 2.0;
const float rayTMin = 1.0;
const float sunRayLength = 100000.0;
const float reflectionRayLength = 20000.0;

// How far the hemisphere ray looks for a bounce surface, in world units. A unit is roughly 1.4 cm,
// so this is about 7 m: far enough to pick up the wall across a room and the ground under an
// overhang, short enough that an open field still sees mostly sky.
//
// This is the single most visually sensitive constant in the indirect path, and it trades off in two
// directions at once. Too short and the bounce degenerates into a thin contact line and the
// occlusion with it; too long and every interior turns uniformly grey, because in a corridor almost
// every direction eventually hits something and sky visibility collapses to zero everywhere.
const float bounceRayLength = 500.0;

layout(location = 0) rayPayloadEXT vec4 payload;

// View-space position for a pixel, which is where reprojection has to happen. The world position is
// derived from this rather than the other way round: worldPos carries the camera's own magnitude --
// up to 250,000 units -- in every component, so it is the wrong space to do arithmetic in.
vec4 reconstructViewPos(vec2 uv, float depth) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 viewPos = camera.projInverse * clipPos;
    return viewPos / viewPos.w;
}

// Octahedral normal encoding, two snorm16 in one uint. Under a degree of error, which is invisible
// next to the ~25 degree rejection threshold it feeds.
vec2 octWrap(vec2 v) {
    return (1.0 - abs(v.yx)) * vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
}

uint packNormal(vec3 n) {
    n /= (abs(n.x) + abs(n.y) + abs(n.z));
    vec2 e = n.z >= 0.0 ? n.xy : octWrap(n.xy);
    ivec2 q = ivec2(round(clamp(e, -1.0, 1.0) * 32767.0));
    return (uint(q.x) & 0xFFFFu) | ((uint(q.y) & 0xFFFFu) << 16);
}

// Cheap integer avalanche hash. Good enough to decorrelate a two-dimensional jitter and far cheaper
// than a blue noise texture lookup, which would need another descriptor and another image.
uint hashUint(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

// Uniformly distributed direction within a cone of half-angle acos(cosThetaMax) around dir.
//
// Note this is uniform over solid angle, not over the projected disc: the sun is a spherical cap
// source, and sampling its disc uniformly would bias the result towards the rim. At the angles
// involved the difference is tiny, but it costs nothing to be right.
//
// At cosThetaMax == 1.0 this returns dir exactly -- cosTheta is 1, sinTheta is 0 -- so a zero-radius
// sun reproduces the previous hard shadow bit for bit rather than approximately.
vec3 sampleCone(vec3 dir, float cosThetaMax, vec2 xi) {
    float cosTheta = mix(cosThetaMax, 1.0, xi.x);
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    float phi = 6.28318530718 * xi.y;

    // Any vector not parallel to dir will do for the basis; the world is Z-up, so Z is the usual
    // pick and X covers the degenerate case of a sun directly overhead.
    vec3 up = abs(dir.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, dir));
    vec3 bitangent = cross(dir, tangent);

    return normalize(dir * cosTheta + tangent * (sinTheta * cos(phi)) + bitangent * (sinTheta * sin(phi)));
}

// Cosine-weighted direction in the hemisphere about n, via Malley's method: a uniform point on the
// disc lifted to the hemisphere. Cosine weighting is not a refinement here, it is what makes the
// estimator correct -- the ambient term this modulates is a cosine-weighted integral over the
// hemisphere, so sampling uniformly would need an explicit NdotL weight per sample and would spend
// most of its samples near the horizon where that weight is almost zero.
vec3 sampleCosineHemisphere(vec3 n, vec2 xi) {
    float r = sqrt(xi.x);
    float phi = 6.28318530718 * xi.y;
    float x = r * cos(phi);
    float y = r * sin(phi);
    float z = sqrt(max(0.0, 1.0 - xi.x));

    vec3 up = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);

    return normalize(tangent * x + bitangent * y + n * z);
}

vec3 unpackNormal(uint bits) {
    // Sign-extend the two 16-bit halves by hand rather than relying on a shift of a converted int.
    int qx = int(bits & 0xFFFFu);
    int qy = int((bits >> 16) & 0xFFFFu);
    if (qx > 32767) qx -= 65536;
    if (qy > 32767) qy -= 65536;

    vec2 e = vec2(qx, qy) / 32767.0;
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    float t = max(-n.z, 0.0);
    n.xy += vec2(n.x >= 0.0 ? -t : t, n.y >= 0.0 ? -t : t);
    return normalize(n);
}

// --- The water surface's reflection ---------------------------------------------------------------
//
// Morrowind's water is a single flat plane at a height the scene UBO already carries, and it is
// deliberately NOT in the acceleration structure -- water stopped going into terrain.chunks when the
// surface moved into the composite pass. Both facts are what make this affordable. The plane can be
// intersected in closed form instead of traced, so it needs no geometry, no BLAS and no TLAS rebuild;
// and a ray leaving the plane cannot turn round and hit the plane, so the reflection needs no
// self-intersection handling beyond the usual bias.
//
// The OSG renderer produces the same picture by re-rendering the world into a mirrored render target
// at reduced detail, with actors left out of it entirely by default. This is one ray.

// Half resolution: the top-left pixel of each 2x2 block does the work and stores at pixelCoord >> 1.
// Every other lane in the subgroup idles through it, which costs nothing in traversal -- the ray count
// really is a quarter -- and the alternative, a compacted launch, would need a second pipeline and a
// second shader binding table for one ray.
bool isWaterReflectionPixel(ivec2 pixelCoord) {
    return ((pixelCoord.x | pixelCoord.y) & 1) == 0;
}

// Wave field constants, and every one of them has to stay equal to water.frag's copy. If they drift,
// the direction the reflection arrives from stops agreeing with the Fresnel and the sun glitter drawn
// over it, and the sea reads as a mirror with a separate, differently-moving texture painted on top --
// which looks like a texture bug rather than like a mismatch, so it is not an easy one to trace back.
//
// Copied rather than included: CompileShaders.cmake runs glslangValidator straight off disk with no
// include path. Same arrangement as vertexTexCoord in closesthit.rchit and anyhit.rahit; edit
// together.
const float sWaveChoppyness = 0.05;
const float sWaveScale = 75.0;
const float sWaveBump = 0.5;
const vec2 sWindDir = vec2(0.5, -0.8);
const float sWindSpeed = 0.2;
// water.frag spells this as worldPos.xy / (8192.0 * 5.0) * 3.0.
const float sWaveUvScale = 3.0 / (8192.0 * 5.0);

// Exposure and tone map, copied from composite.frag, and they have to stay copies for the reason set
// out where they are used below.
const float sAcesPreExposure = 0.6;
const float sExposure = 4.0;
const float sTonemapStrength = 0.25;

// Half weight on the sun, exactly as composite.frag's one-bounce term does it, and for the same
// reason its comment gives there: nothing here knows whether the reflected surface was itself lit.
const float sReflectSunFactor = 0.5;

// Narkowicz's fit to the ACES RRT+ODT, verbatim from composite.frag including its pre-exposure. See
// the note there: the output is display-*linear*, so there is no transfer function in it and none
// should be added.
vec3 acesFilmic(vec3 x) {
    x *= sAcesPreExposure;
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

vec2 waveCoords(vec2 uv, float scale, float speed, float time, float timer1, float timer2, vec3 previousNormal) {
    return uv * (sWaveScale * scale) + sWindDir * time * (sWindSpeed * speed)
        - (previousNormal.xy / previousNormal.zz) * sWaveChoppyness + vec2(time * timer1, time * timer2);
}

// Mip level for one wave octave. A ray tracing shader has no derivatives, so textureLod is the only
// sampling function available to it and the level has to be worked out by hand.
//
// This is not a formality. water.frag gets its filtering from the rasteriser, and at a few hundred
// metres the six octaves compress to well under a pixel: sampled at level 0 there, the normal changes
// completely between one texel and the next. That is a randomly oriented mirror, and it sparkles --
// the exact artifact half resolution makes worse, and the reason this shader does not need a temporal
// filter to look stable.
//
// The footprint is derived, not tuned. A pixel subtends 2 / (P[1][1] * height) radians vertically, so
// at distance t along the view ray it spans t times that many world units across the ray. On a plane
// seen at a grazing angle the footprint *along* the plane is stretched by 1 / |rayDir.z|, which is why
// the horizon is the worst case and why it is the horizon that shimmers if this is left out. Octave i
// samples the map at worldXY * sWaveUvScale * sWaveScale * scale, so its footprint in that octave's
// own texture space scales with `scale` -- hence the log2, which spreads the six octaves across about
// five mip levels the way the rasteriser would have.
float waveLod(float baseLod, float scale) {
    return baseLod + log2(scale);
}

// One water texel: intersect the plane, build the wave normal, fire one ray, store finished radiance.
//
// Called before the sky early-out in main, and that ordering is the easiest thing here to get wrong.
// Most of the sea on screen has sky behind it rather than seabed, so a reflection computed after that
// return would only ever reach the shallows -- and a screenshot of a bay is mostly shallows, so it
// would look like it worked.
void traceWaterReflection(ivec2 pixelCoord, ivec2 launchSize, vec2 uv, float sceneDepth) {
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 rayView = camera.projInverse * vec4(ndc, 1.0, 1.0);
    vec3 rayDir = normalize((camera.viewInverse * vec4(rayView.xyz / rayView.w, 0.0)).xyz);
    vec3 cameraPos = camera.viewInverse[3].xyz;

    // The flat-plane sky reflection, which is what water.frag drew at every pixel before this existed.
    // It is the fallback, and it is written even for a texel with no water anywhere near it.
    //
    // That last part is not padding. water.frag reads this image with a bilinear fetch, so along every
    // shoreline its 2x2 footprint straddles texels whose view ray never reached the sea. Zero in those
    // puts a dark fringe around every island and every rock in the water; this puts the old sky
    // reflection there instead, so the worst a shoreline can do is fall back to what it used to be.
    vec3 flatReflect = reflect(rayDir, vec3(0.0, 0.0, 1.0));
    vec4 result = vec4(
        mix(camera.fogColor.rgb, camera.skyColor.rgb, clamp(flatReflect.z, 0.0, 1.0)), 1.0);

    float waterHeight = camera.sunParams.z;

    // Below the surface water.frag throws the reflection away and substitutes the water colour: past
    // about 49 degrees the underside of the sea is a mirror of an underwater world this renderer does
    // not draw, and reflecting the sky there reads as a hole in the sea. So the ray would be traced
    // and discarded. Skipping it is the one early-out in this function that saves a ray rather than
    // just some arithmetic.
    bool above = cameraPos.z > waterHeight;

    // Zero exactly along the horizon, where the plane is edge on. Same guard and same reasoning as
    // water.frag: an infinity here turns the wave lookups into NaN, and a NaN reflection is a hole in
    // the sea rather than a subtle error.
    float denom = rayDir.z;
    if (abs(denom) < 1.0e-6)
        denom = denom < 0.0 ? -1.0e-6 : 1.0e-6;
    float toPlane = (waterHeight - cameraPos.z) / denom;

    bool traceIt = camera.sunParams.w > 0.0 && above && toPlane > 0.0;

    vec3 worldPos = vec3(0.0);
    if (traceIt) {
        worldPos = cameraPos + rayDir * toPlane;

        // Is the sea actually in front of what the G-buffer recorded here, or behind a cliff? Compared
        // in view space rather than on raw depth values, because a depth buffer is hyperbolic and a
        // comparison on it means something different at each end of the range. At sceneDepth 1.0 the
        // reconstruction lands on the far plane, which nothing is ever nearer than -- so a sky pixel
        // correctly counts as water in front, which is most of the sea.
        //
        // Both numbers are negative and grow more negative with distance, so nearer is greater.
        float planeViewZ = (camera.view * vec4(worldPos, 1.0)).z;
        traceIt = planeViewZ > reconstructViewPos(uv, sceneDepth).z;
    }

    if (traceIt) {
        float time = camera.sunParams.y;
        vec2 waveUv = worldPos.xy * sWaveUvScale;

        // glToVulkanProjection negates the whole of row 1, so P[1][1] is -1/tan(fovY/2) here. The
        // magnitude is what the footprint wants; taking it signed gives a negative level that clamps
        // to 0 and puts the sparkle straight back.
        float pixelAngle = 2.0 / (abs(camera.projection[1][1]) * float(launchSize.y));
        float texWidth = float(textureSize(textures[camera.waterNormalMap], 0).x);
        float footprint = toPlane * pixelAngle / max(abs(rayDir.z), 0.02);
        float baseLod = log2(max(footprint * sWaveUvScale * sWaveScale * texWidth, 1.0));

        // The same six octaves water.frag builds, in the same order, at the same scales and speeds and
        // with the same pair of per-octave timers, each lookup displaced by the previous octave's
        // normal. That feedback is the whole effect and it is why the six cannot be reordered, and why
        // dropping the fine ones to save taps would change the coarse ones too.
        //
        // The seed is (0,0,1) rather than (0,0,0) for the same reason water.frag uses it: waveCoords
        // divides xy by zz.
        vec3 seed = vec3(0.0, 0.0, 1.0);
        vec3 n0 = 2.0 * textureLod(textures[camera.waterNormalMap],
            waveCoords(waveUv, 0.05, 0.04, time, -0.015, -0.005, seed), waveLod(baseLod, 0.05)).rgb - 1.0;
        vec3 n1 = 2.0 * textureLod(textures[camera.waterNormalMap],
            waveCoords(waveUv, 0.1, 0.08, time, 0.02, 0.015, n0), waveLod(baseLod, 0.1)).rgb - 1.0;
        vec3 n2 = 2.0 * textureLod(textures[camera.waterNormalMap],
            waveCoords(waveUv, 0.25, 0.07, time, -0.04, -0.03, n1), waveLod(baseLod, 0.25)).rgb - 1.0;
        vec3 n3 = 2.0 * textureLod(textures[camera.waterNormalMap],
            waveCoords(waveUv, 0.5, 0.09, time, 0.03, 0.04, n2), waveLod(baseLod, 0.5)).rgb - 1.0;
        vec3 n4 = 2.0 * textureLod(textures[camera.waterNormalMap],
            waveCoords(waveUv, 1.0, 0.4, time, -0.02, 0.1, n3), waveLod(baseLod, 1.0)).rgb - 1.0;
        vec3 n5 = 2.0 * textureLod(textures[camera.waterNormalMap],
            waveCoords(waveUv, 2.0, 0.7, time, 0.1, -0.06, n4), waveLod(baseLod, 2.0)).rgb - 1.0;

        vec3 normal = (n0 + n1 + n2 + n3 + n4 + n5) * 0.1;
        normal = normalize(vec3(-normal.x * sWaveBump, -normal.y * sWaveBump, normal.z));

        vec3 reflectDir = reflect(rayDir, normal);

        // A steep enough wave face reflects the view ray back down through the plane. Nothing stops
        // that ray -- the water is not in the acceleration structure -- so it would carry on and come
        // back with the seabed, which is refraction's answer to a reflection's question and reads as a
        // patch of mud floating on the sea. Bending it back to horizontal is where the real ray would
        // go after grazing the far side of the wave, and it is what the OSG reflection map does
        // implicitly by having nothing below its own horizon.
        reflectDir = normalize(vec3(reflectDir.xy, max(reflectDir.z, 1.0e-3)));

        // Capped at the fog end. Past there everything resolves to the fog colour, and a miss already
        // comes back as the sky lerp that the fog turns into exactly that -- so a longer ray buys a
        // traversal across the whole loaded cell grid to reach an answer the miss shader gives for
        // free. At OpenMW's default viewing distance of 7168 units that is a third of
        // reflectionRayLength, and the saving lands where it is needed most: at a grazing angle, where
        // the ray runs nearly parallel to the sea and crosses everything in the world.
        //
        // The lower clamp is not paranoia about a divide. SceneData::fogParams defaults to zeros and
        // is refilled from the weather every frame, so a frame that arrives before the weather is set
        // up -- or a cell with fog effectively off -- would otherwise ask for a ray of length zero and
        // get a sea that reflects nothing but sky. 2000 units is about 28 m, enough for an interior
        // pool to reflect the room around it.
        float rayLength = clamp(camera.fogParams.y, 2000.0, reflectionRayLength);

        // No TerminateOnFirstHit: that returns an arbitrary intersection rather than the nearest one,
        // which is fine for a visibility test and wrong for a reflection. Any-hit still runs, so
        // alpha-tested foliage is cut out of the reflection the same way it is cut out of the bounce.
        payload = vec4(0.0, 0.0, 0.0, -1.0);
        traceRayEXT(topLevelAS,
            gl_RayFlagsNoneEXT,
            0xFF,
            0, 0,
            0,
            worldPos + vec3(0.0, 0.0, rayBias),
            rayTMin,
            reflectDir,
            rayLength,
            0);

        vec3 radiance;
        if (payload.w < 0.0) {
            // A miss needs nothing done to it. miss.rmiss returns mix(fogColor, skyColor, up), which
            // is the identical expression composite.frag draws the visible sky with -- and composite
            // draws the sky on its early-out path, with no exposure and no tone map. So neither does
            // this. Applying either would make the reflected sky brighter than the sky it sits under,
            // along a horizon where the two meet edge to edge.
            radiance = payload.rgb;
        } else {
            // A hit returns the surface's albedo and nothing else: closesthit.rchit does not light it,
            // does not shadow it and does not fog it. Left raw, a reflected cliff arrives as flat
            // full-brightness texture, which next to a correctly lit sky reads as a pale cut-out
            // rather than as a reflection.
            //
            // Lit with composite.frag's own one-bounce formula, and inheriting its argument: there is
            // no hit normal in the payload and no shadow ray from the hit, so the sun is half-weighted
            // to acknowledge that some of what is reflected stands in shadow. The remaining errors
            // point in opposite directions -- no NdotL makes the sun term too generous, no occlusion
            // makes the ambient term too generous, no shadow ray makes both too bright -- so the total
            // lands closer than any of the pieces.
            //
            // Doing it honestly costs a second ray from the hit point plus the hit normal in the
            // payload, and the payload is a bare vec4 shared by the shadow, bounce and reflection rays
            // across five shaders, with the contract spelled out on the shadow trace in main. Widening
            // it is a much larger change than a water reflection should be allowed to drag in.
            vec3 lit = payload.rgb * (camera.ambientColor.rgb + camera.sunColor.rgb * sReflectSunFactor);

            // Exposure and the tone map, because composite.frag applies both to everything that is not
            // sky before this image is ever blended over the result. Skipping them leaves the
            // reflected cliff a quarter as bright as the real cliff standing beside it, which is the
            // most obvious way this can be wrong and the easiest to overlook in a shot of open water
            // where there is nothing to compare against.
            //
            // These constants are copies of composite.frag's and have to stay copies; there is nowhere
            // to share them from. If that shader's exposure or tone map blend is retuned, retune here
            // in the same commit.
            vec3 exposed = lit * sExposure;
            lit = mix(clamp(exposed, 0.0, 1.0), acesFilmic(exposed), sTonemapStrength);

            // Fog over the reflected leg only -- surface out to whatever it hit. water.frag fogs the
            // other leg, surface back to the eye, on the finished pixel. Splitting it that way is what
            // fogs each leg exactly once: folding both in here would double the near leg, and folding
            // neither leaves a reflected headland crisp while the real one at the same distance has
            // faded out.
            //
            // Mixed linearly, matching the fog in water.frag. composite.frag does its fog in the
            // encoded domain instead, so a reflected cliff and the real cliff at equal distance will
            // not land on precisely the same colour in heavy weather. That difference is real and it
            // is second order here: this term is Fresnel-weighted and then fogged again on the way out.
            float fogRange = max(camera.fogParams.y - camera.fogParams.x, 1.0);
            float fogValue = clamp((payload.w - camera.fogParams.x) / fogRange, 0.0, 1.0);
            radiance = mix(lit, camera.fogColor.rgb, fogValue);
        }

        result = vec4(radiance, 1.0);
    }

    // Written on every path. Nothing else touches this image, so a texel left alone keeps a reflection
    // of wherever the camera was standing when it was last written -- which after a fast turn is a
    // slab of the wrong coastline sitting on the sea. The alpha is 1 here and 1 on the fallback path
    // too, so it is 0 only when this shader did not run at all: for the whole image or none of it,
    // never for part of one, which is what lets water.frag treat it as a switch instead of a blend.
    imageStore(waterReflectOut, pixelCoord >> 1, result);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    ivec2 launchSize = ivec2(gl_LaunchSizeEXT.xy);
    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(launchSize);

    float depth = texture(gbufferDepth, uv).r;
    vec4 normalSample = texture(gbufferNormal, uv);

    // The water reflection goes first, before the sky early-out below returns. Water in front of sky
    // is not a corner case -- it is most of the sea in any coastal view, because the seabed drops out
    // of the depth buffer long before the surface does.
    if (isWaterReflectionPixel(pixelCoord))
        traceWaterReflection(pixelCoord, launchSize, uv, depth);

    if (depth >= 1.0) {
        imageStore(outputImage, pixelCoord, vec4(1.0, 0.0, 0.0, 0.0));
        // Sky pixels still have to write both history images, and this is not optional bookkeeping.
        // The images ping-pong, so anything left unwritten this frame still holds frame N-2's data,
        // which a later reprojection would happily accept as if it were frame N-1's. Zeroing gives a
        // stored view-space Z of 0.0, which fails the depth test against any real surface.
        imageStore(historyOut, pixelCoord, vec4(0.0));
        imageStore(geomOut, pixelCoord, uvec4(0u));
        // Nothing occludes the sky and it receives no bounce. Writing rather than leaving these
        // stale matters for the same ping-pong reason the history images do -- and because
        // composite.frag samples the output at every pixel, so a stale value would tint the horizon.
        imageStore(indirectOut, pixelCoord, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(indirectImage, pixelCoord, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec4 viewPos = reconstructViewPos(uv, depth);
    vec3 worldPos = (camera.viewInverse * viewPos).xyz;
    vec3 N = normalize(normalSample.rgb * 2.0 - 1.0);
    // The camera's world position is the translation column of viewInverse, so this is free.
    vec3 cameraPos = camera.viewInverse[3].xyz;

    // Direction towards the light. Matches composite.frag, which uses L = normalize(-sunDirection).
    vec3 sunDir = normalize(-camera.sunDirection.xyz);

    // Give the sun its angular radius instead of treating it as a delta light. This is the whole
    // reason the accumulator above exists: one jittered sample per pixel per frame is pure noise on
    // its own, and only becomes a penumbra once it is averaged over a history.
    //
    // It costs no extra ray, no extra bandwidth, no payload change and no G-buffer channel -- the
    // shadow ray was already being traced, and this only perturbs its direction.
    //
    // The sequence must vary with BOTH pixel and frame. A per-pixel-only sequence gives every pixel
    // a fixed offset that never changes, so every frame draws the identical sample and the
    // accumulator averages sixteen copies of the same wrong answer -- it would look like a slightly
    // displaced hard shadow rather than a soft one, and it would look stable, which is worse because
    // it reads as correct.
    // One decorrelated stream per pixel per frame, shared by the sun jitter and the AO direction.
    // Both must move every frame or the accumulator averages repeated copies of one sample.
    uint seed = hashUint(uint(pixelCoord.x) * 73856093u
        ^ uint(pixelCoord.y) * 19349663u
        ^ camera.frameIndex * 83492791u);
    uint seedB = hashUint(seed);
    uint seedC = hashUint(seedB);
    uint seedD = hashUint(seedC);
    vec2 sunXi = vec2(float(seed  & 0x00FFFFFFu), float(seedB & 0x00FFFFFFu)) / 16777216.0;
    vec2 aoXi  = vec2(float(seedC & 0x00FFFFFFu), float(seedD & 0x00FFFFFFu)) / 16777216.0;

    if (camera.sunParams.x < 1.0)
        sunDir = sampleCone(sunDir, camera.sunParams.x, sunXi);

    float shadowFactor = 1.0;

    // Shadow ray. No gl_RayFlagsOpaqueEXT: it would force every geometry opaque and suppress
    // anyhit.rahit, which is what alpha-tests Morrowind's leaf billboards out of the occluder set.
    //
    // SkipClosestHitShader does not skip the any-hit shader, so the payload contract is unchanged:
    // it is pre-initialised to vec4(0.0), an accepted hit leaves it at 0, and shadow.rmiss writes
    // w = 1. Nothing on the hit path writes the payload -- do not "fix" anyhit.rahit to do so.
    payload = vec4(0.0);
    vec3 shadowOrigin = worldPos + N * rayBias;
    traceRayEXT(topLevelAS,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
        0xFF,
        0, 0,
        1,
        shadowOrigin,
        rayTMin,
        sunDir,
        sunRayLength,
        0);
    shadowFactor = payload.w;

    // One hemisphere ray, giving both the indirect bounce and the ambient occlusion.
    //
    // Occlusion and the first bounce are the same query asked two ways: "did anything block this
    // direction" and "what colour was it". Miss index 0 routes a miss to miss.rmiss, which writes
    // w = -1, and a hit runs closesthit.rchit, which writes the surface albedo with w = the hit
    // distance. So the sign of w is the occlusion term and the rgb is the bounce colour, from a
    // single trace. Ambient occlusion is not a separate feature here; it is the shadow that
    // one-bounce GI casts.
    //
    // Note this ray deliberately does NOT set gl_RayFlagsTerminateOnFirstHitEXT, unlike the shadow
    // ray. Terminating on the first hit found returns an arbitrary intersection, not the nearest one,
    // which is fine for a binary visibility test and wrong for a bounce colour. Any-hit still runs,
    // so alpha-tested foliage is still cut out of the bounce.
    payload = vec4(0.0, 0.0, 0.0, -1.0);
    vec3 bounceDir = sampleCosineHemisphere(N, aoXi);
    traceRayEXT(topLevelAS,
        gl_RayFlagsNoneEXT,
        0xFF,
        0, 0,
        0,
        worldPos + N * rayBias,
        rayTMin,
        bounceDir,
        bounceRayLength,
        0);

    // Sky visibility: 1 when the ray escaped. Bounded range rather than an unbounded query, because
    // occlusion past bounceRayLength is better described as "no nearby bounce surface" than as
    // shadow, and treating it as shadow is what makes naive AO flatten interiors into uniform grey.
    float rawSkyVisibility = payload.w < 0.0 ? 1.0 : 0.0;

    // Albedo of the bounce surface, NOT its radiance. Storing a lit colour would put the weather,
    // the sunrise and the lightning flash into a 32-frame history; an albedo is frame-invariant, and
    // composite.frag multiplies it by whatever the light happens to be this frame. Zero on a miss --
    // the sky's contribution is carried by rawSkyVisibility and coloured in the composite pass.
    vec3 rawBounce = payload.w < 0.0 ? vec3(0.0) : payload.rgb;

    // Reflection ray, but only where it can affect the image.
    //
    // composite.frag weights the reflection by the material's specular strength, and vanilla Morrowind
    // resolves to zero specular for everything -- nifosg::Loader::applyDrawableProperties zeroes it for
    // any NIF at or below the Morrowind version, and MeshConverter honours the same gate. Tracing a
    // full-resolution reflection ray per pixel and then multiplying it by zero was costing roughly half
    // the ray budget for no visible result, which matters enormously on a handheld.
    //
    // The green channel of the material target carries specular strength; see gbuffer.frag, where it
    // replaced metallic because Morrowind has no metals. The threshold is deliberately just above zero
    // rather than an exact compare: the value round-trips through an 8-bit UNORM attachment.
    payload = vec4(0.0);
    float specularStrength = texture(gbufferMaterial, uv).g;
    if (specularStrength > 0.004)
    {
        vec3 viewDir = normalize(worldPos - cameraPos);
        vec3 reflectDir = reflect(viewDir, N);

        vec3 reflOrigin = worldPos + N * rayBias;
        traceRayEXT(topLevelAS,
            gl_RayFlagsNoneEXT,
            0xFF,
            0, 0,
            0,
            reflOrigin,
            rayTMin,
            reflectDir,
            reflectionRayLength,
            0);
    }

    // --- Temporal accumulation -------------------------------------------------------------------
    //
    // What is accumulated is the sun visibility mask, and deliberately not radiance. composite.frag
    // applies every colour in the scene -- sun, ambient, sky, fog, point lights -- *after* reading
    // this image, so none of it is ever in the history and none of it can ghost. Sun colour in
    // particular swings hard and abruptly across weather transitions, sunrise and the lightning
    // flash; a radiance accumulator would smear a lightning flash over sixteen frames, and a
    // visibility accumulator structurally cannot. Keep it that way.
    //
    // Visibility is also view-independent, and with a static TLAS a correctly reprojected sample is
    // not merely a plausible neighbour of the right answer, it *is* the right answer. That is what
    // affords a 32-frame history where a TAA-style accumulator tolerates 4 to 8.
    float rawVisibility = shadowFactor;

    // Reproject through view space. prevClip uses *this* frame's projection on purpose: the previous
    // projection only changes on a resize or an FOV change, and both discard the history anyway.
    vec4 prevViewPos = camera.prevViewFromCurView * vec4(viewPos.xyz, 1.0);
    vec4 prevClip = camera.projection * prevViewPos;

    float historyMean = 0.0;
    float historyMoment = 0.0;
    float historyAo = 0.0;
    float historyAge = 0.0;
    vec3 historyBounce = vec3(0.0);

    if (prevClip.w > 0.0) {
        // Already Vulkan-convention: camera.projection is glToVulkanProjection-corrected on the CPU,
        // so y is 0 at the top of the screen. composite.frag flips y for its sky gradient (that is a
        // screen-space gradient, a different thing) -- do not copy that flip here.
        vec2 prevUv = (prevClip.xy / prevClip.w) * 0.5 + 0.5;

        if (all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThan(prevUv, vec2(1.0)))) {
            // Depth slope term. At grazing incidence one pixel spans a large depth range, so a flat
            // relative tolerance rejects the whole surface -- which for Morrowind means the entire
            // ground plane, a 128-unit heightfield almost always viewed edge-on. 1/NdotV is the
            // first-order model of that gradient and it is the cheap-but-correct version here:
            // raygen has no derivatives to estimate dz/duv from, there being no quads in a ray
            // tracing shader, and gathering neighbour depths would cost more than the whole test.
            vec3 V = normalize(cameraPos - worldPos);
            float ndotv = max(abs(dot(N, V)), 0.1);
            float tolerance = abs(prevViewPos.z) * (camera.denoiseParams.y + 2.0 * camera.denoiseParams.y / ndotv);

            // Manual 2x2 bilinear gather with per-tap validity. Rejected taps take weight 0 and the
            // survivors are renormalised, which fixes both the correctness problem (history bleeding
            // across a silhouette) and the degenerate case where one valid tap at 0.03 weight is
            // swamped by three rejected ones.
            vec2 prevPixel = prevUv * vec2(launchSize) - 0.5;
            vec2 baseCoord = floor(prevPixel);
            vec2 frac = prevPixel - baseCoord;
            ivec2 base = ivec2(baseCoord);

            float weights[4] = float[4](
                (1.0 - frac.x) * (1.0 - frac.y),
                frac.x * (1.0 - frac.y),
                (1.0 - frac.x) * frac.y,
                frac.x * frac.y);
            ivec2 offsets[4] = ivec2[4](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));

            float totalWeight = 0.0;
            for (int i = 0; i < 4; ++i) {
                ivec2 tap = base + offsets[i];
                if (any(lessThan(tap, ivec2(0))) || any(greaterThanEqual(tap, launchSize)))
                    continue;

                uvec2 geom = imageLoad(geomIn, tap).xy;
                float storedZ = uintBitsToFloat(geom.x);
                if (abs(storedZ - prevViewPos.z) >= tolerance)
                    continue;

                // World-space normals, compared unrotated. The scene is static, so a surface's world
                // normal is frame-invariant and there is nothing to transform.
                if (dot(N, unpackNormal(geom.y)) <= camera.denoiseParams.z)
                    continue;

                vec4 tapHistory = imageLoad(historyIn, tap);
                historyMean += weights[i] * tapHistory.r;
                historyMoment += weights[i] * tapHistory.g;
                historyAo += weights[i] * tapHistory.b;
                historyAge += weights[i] * tapHistory.a;
                // The bounce rides the same tap: if a tap is trustworthy for visibility it is
                // trustworthy for the indirect term, since both describe the same surface.
                historyBounce += weights[i] * imageLoad(indirectIn, tap).rgb;
                totalWeight += weights[i];
            }

            // Below this the surviving taps are too marginal to renormalise meaningfully; treat it as
            // a full rejection rather than amplifying one corner tap by 20x.
            if (totalWeight > 0.05) {
                historyMean /= totalWeight;
                historyMoment /= totalWeight;
                historyAo /= totalWeight;
                historyAge /= totalWeight;
                historyBounce /= totalWeight;
            } else {
                historyMean = 0.0;
                historyMoment = 0.0;
                historyAo = 0.0;
                historyAge = 0.0;
                historyBounce = vec3(0.0);

                // Widen the search before giving up. The 2x2 gather failing usually means the
                // reprojection landed a pixel or two off the surface -- at a silhouette, or where the
                // camera moved enough that the exact footprint moved off it -- not that this surface
                // was genuinely invisible last frame. Somewhere just outside that 2x2 there is often
                // a tap of the same surface, and taking it is far better than starting from nothing:
                // a pixel with no history is one raw sample of the sun cone and one of the hemisphere.
                //
                // Same depth and normal tests as above, so this cannot accept anything the tight
                // gather would have rejected on merit -- only things it never looked at.
                //
                // The seeded history is deliberately given an age of 1, not the age it inherits. The
                // sample is a neighbour's, not this pixel's, so it has earned one frame of confidence
                // and no more; letting it inherit a 32-frame age would lock in a value from the wrong
                // footprint and hold it there. One frame is enough to skip the worst of the noise and
                // let the normal accumulation take over immediately.
                for (int radius = 2; radius <= 3 && historyAge == 0.0; ++radius) {
                    for (int y = -radius; y <= radius && historyAge == 0.0; ++y) {
                        for (int x = -radius; x <= radius; ++x) {
                            // Only the ring at this radius; the inside was covered already.
                            if (abs(x) != radius && abs(y) != radius)
                                continue;

                            ivec2 tap = base + ivec2(x, y);
                            if (any(lessThan(tap, ivec2(0))) || any(greaterThanEqual(tap, launchSize)))
                                continue;

                            uvec2 geom = imageLoad(geomIn, tap).xy;
                            if (abs(uintBitsToFloat(geom.x) - prevViewPos.z) >= tolerance)
                                continue;
                            if (dot(N, unpackNormal(geom.y)) <= camera.denoiseParams.z)
                                continue;

                            vec4 tapHistory = imageLoad(historyIn, tap);
                            historyMean = tapHistory.r;
                            historyMoment = tapHistory.g;
                            historyAo = tapHistory.b;
                            historyBounce = imageLoad(indirectIn, tap).rgb;
                            historyAge = 1.0;
                            break;
                        }
                    }
                }
            }
        }
    }

    // Bounded history with an adaptive blend weight. Age starts at 0 on a disocclusion, so the first
    // frame is a pure copy; the weight then falls as 1/n while the estimate is genuinely improving
    // and floors at alphaMin so the filter never stops responding to real change. Ghosting is
    // therefore bounded by construction at 1/alphaMin frames rather than by a heuristic.
    //
    // A max history of 0 is how the renderer discards the history wholesale after a TLAS rebuild: it
    // clamps age to 0, which forces a weight of 1, which is a straight copy of this frame's value.
    float maxHistory = camera.denoiseParams.w;
    float age = min(historyAge, maxHistory);
    float alpha = max(1.0 / (age + 1.0), camera.denoiseParams.x);

    float mean = mix(historyMean, rawVisibility, alpha);
    // Second moment, for the variance estimate a spatial pass will need. Nothing reads it yet; it is
    // in the layout from the start because retrofitting it means rewriting the history format.
    float moment = mix(historyMoment, rawVisibility * rawVisibility, alpha);
    // AO rides the same reprojection, the same rejection tests and the same blend weight as the sun
    // visibility. That is the entire reason the accumulator was built before any stochastic term:
    // adding a second noisy signal costs one channel and one mix, not a second denoiser.
    float skyVisibility = mix(historyAo, rawSkyVisibility, alpha);
    vec3 bounce = mix(historyBounce, rawBounce, alpha);

    imageStore(historyOut, pixelCoord, vec4(mean, moment, skyVisibility, min(age + 1.0, maxHistory)));
    imageStore(indirectOut, pixelCoord, vec4(bounce, skyVisibility));
    imageStore(indirectImage, pixelCoord, vec4(bounce, skyVisibility));
    imageStore(geomOut, pixelCoord, uvec4(floatBitsToUint(viewPos.z), packNormal(N), 0u, 0u));

    // Store the accumulated visibility, plus the raw reflected radiance. composite.frag owns the
    // reflection's weighting and applies a Fresnel term there; this used to scale by a magic 0.3
    // (hit) / 0.05 (miss) as well, and the two attenuations multiplied out to roughly 6%, which made
    // the reflection ray almost pure cost.
    //
    // The reflection is deliberately not accumulated: it is view-dependent, so a reprojected sample
    // is not the right answer for the current view the way a visibility sample is.
    //
    // Caveat worth knowing: closesthit.rchit returns the hit surface's albedo, not its radiance -- it
    // is not lit, not shadowed and not fogged. Reflections are therefore uniformly too bright and flat,
    // and fixing that means shading at the hit point, which needs the light set the hit shaders do not
    // have yet.
    imageStore(outputImage, pixelCoord, vec4(mean, payload.xyz));
}
