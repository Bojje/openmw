#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba16f) uniform image2D outputImage;
layout(set = 0, binding = 2) uniform sampler2D gbufferAlbedo;
layout(set = 0, binding = 3) uniform sampler2D gbufferNormal;
layout(set = 0, binding = 4) uniform sampler2D gbufferDepth;
layout(set = 0, binding = 8) uniform sampler2D gbufferMaterial;

// Temporal accumulator history. Read and write are separate images, and they have to be: pixel A
// reads the history at pixel B's reprojected location, which pixel B may already have overwritten.
// There is no ordering between raygen invocations, so a read-modify-write history is a data race.
//
// Storage images rather than samplers so the 2x2 gather can be done by hand: a tap that fails the
// depth or normal test must contribute exactly zero, and a hardware bilinear fetch would have
// blended it in before the shader could look at it.
layout(set = 0, binding =  9, rgba16f) uniform readonly  image2D historyIn;
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D historyOut;
layout(set = 0, binding = 11, rg32ui)  uniform readonly  uimage2D geomIn;
layout(set = 0, binding = 12, rg32ui)  uniform writeonly uimage2D geomOut;

// Ambient occlusion. Its own image because outputImage has no free channel: .r is sun visibility and
// .gba is reflected radiance. r32f rather than a packed format because r16f and b10g11r11 both need
// shaderStorageImageExtendedFormats, which this device does not enable.
layout(set = 0, binding = 13, r32f) uniform writeonly image2D aoImage;

// Read from the scene UBO rather than push constants: two mat4 plus a vec4 is 144 bytes, over the
// 128-byte maxPushConstantsSize that Vulkan guarantees on all implementations.
//
// This must declare EVERY field of Vk::SceneData up to the last one used, in order. A prefix is legal
// GLSL and this shader got away with one for a long time, but the moment it needs a field past
// sunColor, any omitted field shifts every subsequent offset -- and the result is read as *something*,
// so there is no error, no validation message and no crash. Just a silently wrong matrix. Keep this
// in step with vkrenderer.hpp and composite.frag; nothing checks the three agree.
layout(set = 0, binding = 5) uniform SceneUBO {
    mat4 view;
    mat4 projection;
    mat4 viewInverse;
    mat4 projInverse;
    vec4 sunDirection;
    vec4 sunColor;
    vec4 ambientColor;
    vec4 skyColor;
    vec4 fogColor;
    vec4 fogParams;
    mat4 prevViewFromCurView;
    vec4 denoiseParams; // x = alphaMin, y = depth tolerance, z = normal dot, w = max history
    vec4 sunParams;     // x = cos of the sun's angular radius
    uint frameIndex;
    uint lightCount;
    uint scenePad0;
    uint scenePad1;
} camera;

// Morrowind's world unit is roughly 1.4 cm and an exterior cell spans 8192 units, so ray epsilons have
// to be expressed at that scale. A sub-unit bias causes shadow rays to re-intersect their own surface,
// which shows up as dense diagonal acne across every lit face.
const float rayBias = 2.0;
const float rayTMin = 1.0;
const float sunRayLength = 100000.0;
const float reflectionRayLength = 20000.0;

// How far an ambient occlusion ray looks for an occluder, in world units. A unit is roughly 1.4 cm,
// so this is about 2.8 m: far enough to darken the join between a wall and a floor, a doorway recess
// and the underside of a rock, and short enough that an open field stays open. Occlusion beyond this
// distance is what a GI bounce would express, not what AO should.
//
// This is the single most visually sensitive constant in the AO path. Too short and it degenerates
// into a thin contact line; too long and every interior turns uniformly grey, because in a corridor
// almost every hemisphere direction eventually hits something.
const float aoRayLength = 200.0;

layout(location = 0) rayPayloadEXT vec4 payload;

// View-space position for a pixel, which is where reprojection has to happen. The world position is
// derived from this rather than the other way round: worldPos carries the camera's own magnitude --
// up to 250,000 units -- in every component, so it is the wrong space to do arithmetic in.
vec4 reconstructViewPos(vec2 uv, float depth) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 viewPos = camera.projInverse * clipPos;
    return viewPos / viewPos.w;
}

// Octahedral normal encoding, two snorm16 in one uint. Under a degree of error, which is invisible
// next to the ~25 degree rejection threshold it feeds.
vec2 octWrap(vec2 v) {
    return (1.0 - abs(v.yx)) * vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
}

uint packNormal(vec3 n) {
    n /= (abs(n.x) + abs(n.y) + abs(n.z));
    vec2 e = n.z >= 0.0 ? n.xy : octWrap(n.xy);
    ivec2 q = ivec2(round(clamp(e, -1.0, 1.0) * 32767.0));
    return (uint(q.x) & 0xFFFFu) | ((uint(q.y) & 0xFFFFu) << 16);
}

// Cheap integer avalanche hash. Good enough to decorrelate a two-dimensional jitter and far cheaper
// than a blue noise texture lookup, which would need another descriptor and another image.
uint hashUint(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

// Uniformly distributed direction within a cone of half-angle acos(cosThetaMax) around dir.
//
// Note this is uniform over solid angle, not over the projected disc: the sun is a spherical cap
// source, and sampling its disc uniformly would bias the result towards the rim. At the angles
// involved the difference is tiny, but it costs nothing to be right.
//
// At cosThetaMax == 1.0 this returns dir exactly -- cosTheta is 1, sinTheta is 0 -- so a zero-radius
// sun reproduces the previous hard shadow bit for bit rather than approximately.
vec3 sampleCone(vec3 dir, float cosThetaMax, vec2 xi) {
    float cosTheta = mix(cosThetaMax, 1.0, xi.x);
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    float phi = 6.28318530718 * xi.y;

    // Any vector not parallel to dir will do for the basis; the world is Z-up, so Z is the usual
    // pick and X covers the degenerate case of a sun directly overhead.
    vec3 up = abs(dir.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, dir));
    vec3 bitangent = cross(dir, tangent);

    return normalize(dir * cosTheta + tangent * (sinTheta * cos(phi)) + bitangent * (sinTheta * sin(phi)));
}

// Cosine-weighted direction in the hemisphere about n, via Malley's method: a uniform point on the
// disc lifted to the hemisphere. Cosine weighting is not a refinement here, it is what makes the
// estimator correct -- the ambient term this modulates is a cosine-weighted integral over the
// hemisphere, so sampling uniformly would need an explicit NdotL weight per sample and would spend
// most of its samples near the horizon where that weight is almost zero.
vec3 sampleCosineHemisphere(vec3 n, vec2 xi) {
    float r = sqrt(xi.x);
    float phi = 6.28318530718 * xi.y;
    float x = r * cos(phi);
    float y = r * sin(phi);
    float z = sqrt(max(0.0, 1.0 - xi.x));

    vec3 up = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);

    return normalize(tangent * x + bitangent * y + n * z);
}

vec3 unpackNormal(uint bits) {
    // Sign-extend the two 16-bit halves by hand rather than relying on a shift of a converted int.
    int qx = int(bits & 0xFFFFu);
    int qy = int((bits >> 16) & 0xFFFFu);
    if (qx > 32767) qx -= 65536;
    if (qy > 32767) qy -= 65536;

    vec2 e = vec2(qx, qy) / 32767.0;
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    float t = max(-n.z, 0.0);
    n.xy += vec2(n.x >= 0.0 ? -t : t, n.y >= 0.0 ? -t : t);
    return normalize(n);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    ivec2 launchSize = ivec2(gl_LaunchSizeEXT.xy);
    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(launchSize);

    float depth = texture(gbufferDepth, uv).r;
    vec4 normalSample = texture(gbufferNormal, uv);

    if (depth >= 1.0) {
        imageStore(outputImage, pixelCoord, vec4(1.0, 0.0, 0.0, 0.0));
        // Sky pixels still have to write both history images, and this is not optional bookkeeping.
        // The images ping-pong, so anything left unwritten this frame still holds frame N-2's data,
        // which a later reprojection would happily accept as if it were frame N-1's. Zeroing gives a
        // stored view-space Z of 0.0, which fails the depth test against any real surface.
        imageStore(historyOut, pixelCoord, vec4(0.0));
        imageStore(geomOut, pixelCoord, uvec4(0u));
        // Nothing occludes the sky. Writing 1.0 rather than leaving it stale matters for the same
        // ping-pong reason the history images do -- and because composite.frag samples this at every
        // pixel, so a stale value would tint the horizon.
        imageStore(aoImage, pixelCoord, vec4(1.0));
        return;
    }

    vec4 viewPos = reconstructViewPos(uv, depth);
    vec3 worldPos = (camera.viewInverse * viewPos).xyz;
    vec3 N = normalize(normalSample.rgb * 2.0 - 1.0);
    // The camera's world position is the translation column of viewInverse, so this is free.
    vec3 cameraPos = camera.viewInverse[3].xyz;

    // Direction towards the light. Matches composite.frag, which uses L = normalize(-sunDirection).
    vec3 sunDir = normalize(-camera.sunDirection.xyz);

    // Give the sun its angular radius instead of treating it as a delta light. This is the whole
    // reason the accumulator above exists: one jittered sample per pixel per frame is pure noise on
    // its own, and only becomes a penumbra once it is averaged over a history.
    //
    // It costs no extra ray, no extra bandwidth, no payload change and no G-buffer channel -- the
    // shadow ray was already being traced, and this only perturbs its direction.
    //
    // The sequence must vary with BOTH pixel and frame. A per-pixel-only sequence gives every pixel
    // a fixed offset that never changes, so every frame draws the identical sample and the
    // accumulator averages sixteen copies of the same wrong answer -- it would look like a slightly
    // displaced hard shadow rather than a soft one, and it would look stable, which is worse because
    // it reads as correct.
    // One decorrelated stream per pixel per frame, shared by the sun jitter and the AO direction.
    // Both must move every frame or the accumulator averages repeated copies of one sample.
    uint seed = hashUint(uint(pixelCoord.x) * 73856093u
        ^ uint(pixelCoord.y) * 19349663u
        ^ camera.frameIndex * 83492791u);
    uint seedB = hashUint(seed);
    uint seedC = hashUint(seedB);
    uint seedD = hashUint(seedC);
    vec2 sunXi = vec2(float(seed  & 0x00FFFFFFu), float(seedB & 0x00FFFFFFu)) / 16777216.0;
    vec2 aoXi  = vec2(float(seedC & 0x00FFFFFFu), float(seedD & 0x00FFFFFFu)) / 16777216.0;

    if (camera.sunParams.x < 1.0)
        sunDir = sampleCone(sunDir, camera.sunParams.x, sunXi);

    float shadowFactor = 1.0;

    // Shadow ray. No gl_RayFlagsOpaqueEXT: it would force every geometry opaque and suppress
    // anyhit.rahit, which is what alpha-tests Morrowind's leaf billboards out of the occluder set.
    //
    // SkipClosestHitShader does not skip the any-hit shader, so the payload contract is unchanged:
    // it is pre-initialised to vec4(0.0), an accepted hit leaves it at 0, and shadow.rmiss writes
    // w = 1. Nothing on the hit path writes the payload -- do not "fix" anyhit.rahit to do so.
    payload = vec4(0.0);
    vec3 shadowOrigin = worldPos + N * rayBias;
    traceRayEXT(topLevelAS,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
        0xFF,
        0, 0,
        1,
        shadowOrigin,
        rayTMin,
        sunDir,
        sunRayLength,
        0);
    shadowFactor = payload.w;

    // Ambient occlusion. Same payload contract and the same ray flags as the shadow ray -- a hit
    // leaves the pre-trace vec4(0.0) alone and a miss has shadow.rmiss write w = 1 -- so this needs
    // no new miss shader, no new hit group, and no change to the shader binding table. It is the
    // second and last ray this shader traces per pixel for vanilla content, since the reflection ray
    // is gated off wherever specular strength is zero.
    //
    // Deliberately a short ray with a bounded length rather than an unbounded visibility query:
    // occlusion past aoRayLength is what a GI bounce expresses, and treating it as occlusion instead
    // is what makes naive AO turn interiors into uniform grey.
    payload = vec4(0.0);
    vec3 aoDir = sampleCosineHemisphere(N, aoXi);
    traceRayEXT(topLevelAS,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
        0xFF,
        0, 0,
        1,
        worldPos + N * rayBias,
        rayTMin,
        aoDir,
        aoRayLength,
        0);
    float rawAo = payload.w;

    // Reflection ray, but only where it can affect the image.
    //
    // composite.frag weights the reflection by the material's specular strength, and vanilla Morrowind
    // resolves to zero specular for everything -- nifosg::Loader::applyDrawableProperties zeroes it for
    // any NIF at or below the Morrowind version, and MeshConverter honours the same gate. Tracing a
    // full-resolution reflection ray per pixel and then multiplying it by zero was costing roughly half
    // the ray budget for no visible result, which matters enormously on a handheld.
    //
    // The green channel of the material target carries specular strength; see gbuffer.frag, where it
    // replaced metallic because Morrowind has no metals. The threshold is deliberately just above zero
    // rather than an exact compare: the value round-trips through an 8-bit UNORM attachment.
    payload = vec4(0.0);
    float specularStrength = texture(gbufferMaterial, uv).g;
    if (specularStrength > 0.004)
    {
        vec3 viewDir = normalize(worldPos - cameraPos);
        vec3 reflectDir = reflect(viewDir, N);

        vec3 reflOrigin = worldPos + N * rayBias;
        traceRayEXT(topLevelAS,
            gl_RayFlagsNoneEXT,
            0xFF,
            0, 0,
            0,
            reflOrigin,
            rayTMin,
            reflectDir,
            reflectionRayLength,
            0);
    }

    // --- Temporal accumulation -------------------------------------------------------------------
    //
    // What is accumulated is the sun visibility mask, and deliberately not radiance. composite.frag
    // applies every colour in the scene -- sun, ambient, sky, fog, point lights -- *after* reading
    // this image, so none of it is ever in the history and none of it can ghost. Sun colour in
    // particular swings hard and abruptly across weather transitions, sunrise and the lightning
    // flash; a radiance accumulator would smear a lightning flash over sixteen frames, and a
    // visibility accumulator structurally cannot. Keep it that way.
    //
    // Visibility is also view-independent, and with a static TLAS a correctly reprojected sample is
    // not merely a plausible neighbour of the right answer, it *is* the right answer. That is what
    // affords a 32-frame history where a TAA-style accumulator tolerates 4 to 8.
    float rawVisibility = shadowFactor;

    // Reproject through view space. prevClip uses *this* frame's projection on purpose: the previous
    // projection only changes on a resize or an FOV change, and both discard the history anyway.
    vec4 prevViewPos = camera.prevViewFromCurView * vec4(viewPos.xyz, 1.0);
    vec4 prevClip = camera.projection * prevViewPos;

    float historyMean = 0.0;
    float historyMoment = 0.0;
    float historyAo = 0.0;
    float historyAge = 0.0;

    if (prevClip.w > 0.0) {
        // Already Vulkan-convention: camera.projection is glToVulkanProjection-corrected on the CPU,
        // so y is 0 at the top of the screen. composite.frag flips y for its sky gradient (that is a
        // screen-space gradient, a different thing) -- do not copy that flip here.
        vec2 prevUv = (prevClip.xy / prevClip.w) * 0.5 + 0.5;

        if (all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThan(prevUv, vec2(1.0)))) {
            // Depth slope term. At grazing incidence one pixel spans a large depth range, so a flat
            // relative tolerance rejects the whole surface -- which for Morrowind means the entire
            // ground plane, a 128-unit heightfield almost always viewed edge-on. 1/NdotV is the
            // first-order model of that gradient and it is the cheap-but-correct version here:
            // raygen has no derivatives to estimate dz/duv from, there being no quads in a ray
            // tracing shader, and gathering neighbour depths would cost more than the whole test.
            vec3 V = normalize(cameraPos - worldPos);
            float ndotv = max(abs(dot(N, V)), 0.1);
            float tolerance = abs(prevViewPos.z) * (camera.denoiseParams.y + 2.0 * camera.denoiseParams.y / ndotv);

            // Manual 2x2 bilinear gather with per-tap validity. Rejected taps take weight 0 and the
            // survivors are renormalised, which fixes both the correctness problem (history bleeding
            // across a silhouette) and the degenerate case where one valid tap at 0.03 weight is
            // swamped by three rejected ones.
            vec2 prevPixel = prevUv * vec2(launchSize) - 0.5;
            vec2 baseCoord = floor(prevPixel);
            vec2 frac = prevPixel - baseCoord;
            ivec2 base = ivec2(baseCoord);

            float weights[4] = float[4](
                (1.0 - frac.x) * (1.0 - frac.y),
                frac.x * (1.0 - frac.y),
                (1.0 - frac.x) * frac.y,
                frac.x * frac.y);
            ivec2 offsets[4] = ivec2[4](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));

            float totalWeight = 0.0;
            for (int i = 0; i < 4; ++i) {
                ivec2 tap = base + offsets[i];
                if (any(lessThan(tap, ivec2(0))) || any(greaterThanEqual(tap, launchSize)))
                    continue;

                uvec2 geom = imageLoad(geomIn, tap).xy;
                float storedZ = uintBitsToFloat(geom.x);
                if (abs(storedZ - prevViewPos.z) >= tolerance)
                    continue;

                // World-space normals, compared unrotated. The scene is static, so a surface's world
                // normal is frame-invariant and there is nothing to transform.
                if (dot(N, unpackNormal(geom.y)) <= camera.denoiseParams.z)
                    continue;

                vec4 tapHistory = imageLoad(historyIn, tap);
                historyMean += weights[i] * tapHistory.r;
                historyMoment += weights[i] * tapHistory.g;
                historyAo += weights[i] * tapHistory.b;
                historyAge += weights[i] * tapHistory.a;
                totalWeight += weights[i];
            }

            // Below this the surviving taps are too marginal to renormalise meaningfully; treat it as
            // a full rejection rather than amplifying one corner tap by 20x.
            if (totalWeight > 0.05) {
                historyMean /= totalWeight;
                historyMoment /= totalWeight;
                historyAo /= totalWeight;
                historyAge /= totalWeight;
            } else {
                historyMean = 0.0;
                historyMoment = 0.0;
                historyAo = 0.0;
                historyAge = 0.0;
            }
        }
    }

    // Bounded history with an adaptive blend weight. Age starts at 0 on a disocclusion, so the first
    // frame is a pure copy; the weight then falls as 1/n while the estimate is genuinely improving
    // and floors at alphaMin so the filter never stops responding to real change. Ghosting is
    // therefore bounded by construction at 1/alphaMin frames rather than by a heuristic.
    //
    // A max history of 0 is how the renderer discards the history wholesale after a TLAS rebuild: it
    // clamps age to 0, which forces a weight of 1, which is a straight copy of this frame's value.
    float maxHistory = camera.denoiseParams.w;
    float age = min(historyAge, maxHistory);
    float alpha = max(1.0 / (age + 1.0), camera.denoiseParams.x);

    float mean = mix(historyMean, rawVisibility, alpha);
    // Second moment, for the variance estimate a spatial pass will need. Nothing reads it yet; it is
    // in the layout from the start because retrofitting it means rewriting the history format.
    float moment = mix(historyMoment, rawVisibility * rawVisibility, alpha);
    // AO rides the same reprojection, the same rejection tests and the same blend weight as the sun
    // visibility. That is the entire reason the accumulator was built before any stochastic term:
    // adding a second noisy signal costs one channel and one mix, not a second denoiser.
    float ao = mix(historyAo, rawAo, alpha);

    imageStore(historyOut, pixelCoord, vec4(mean, moment, ao, min(age + 1.0, maxHistory)));
    imageStore(aoImage, pixelCoord, vec4(ao, 0.0, 0.0, 0.0));
    imageStore(geomOut, pixelCoord, uvec4(floatBitsToUint(viewPos.z), packNormal(N), 0u, 0u));

    // Store the accumulated visibility, plus the raw reflected radiance. composite.frag owns the
    // reflection's weighting and applies a Fresnel term there; this used to scale by a magic 0.3
    // (hit) / 0.05 (miss) as well, and the two attenuations multiplied out to roughly 6%, which made
    // the reflection ray almost pure cost.
    //
    // The reflection is deliberately not accumulated: it is view-dependent, so a reprojected sample
    // is not the right answer for the current view the way a visibility sample is.
    //
    // Caveat worth knowing: closesthit.rchit returns the hit surface's albedo, not its radiance -- it
    // is not lit, not shadowed and not fogged. Reflections are therefore uniformly too bright and flat,
    // and fixing that means shading at the hit point, which needs the light set the hit shaders do not
    // have yet.
    imageStore(outputImage, pixelCoord, vec4(mean, payload.xyz));
}
